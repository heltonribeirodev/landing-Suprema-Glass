# —— Bloqueia acesso direto a arquivos sensíveis ——————————————————————————
<FilesMatch "^\.env$|^\.env\..*$|\.bak$|\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Libera acesso ao portfolio.json pelo JS (mesmo servidor)
<Files "portfolio.json">
    Order Deny,Allow
    Deny from all
    Allow from 127.0.0.1
    Allow from localhost
    # Em produção o JS do browser acessa via HTTP normal — precisa permitir
    Satisfy Any
</Files>

